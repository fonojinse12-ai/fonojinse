  box-shadow:0 6px 18px -6px rgba(0,0,0,.3);
  opacity:0;visibility:hidden;transform:scale(.85);
  transition:opacity .35s ease,transform .45s cubic-bezier(.16,1,.3,1),visibility .35s,background .25s;
  -webkit-tap-highlight-color:transparent;
}
.nav svg{width:22px;height:22px}
.nav.prev{left:10px}
.nav.next{right:10px}
.nav.show{opacity:1;visibility:visible;transform:scale(1)}
.nav:hover{background:rgba(190,190,196,.85)}
.nav:active{transform:scale(.92)}
.nav:focus-visible{outline:3px solid var(--text);outline-offset:3px}
@media (hover:none) and (pointer:coarse){.nav{display:none}}
.card:active{transform:scale(.98);transition-duration:.15s}
.card.light{background:#fff;color:#1d1d1f;box-shadow:0 18px 40px -16px rgba(30,40,90,.35)}
.card.light .label{color:#c2410c}
