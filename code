<script>
(function(){
  var cards=document.querySelector('.cards'),
      prev=document.querySelector('.nav.prev'),
      next=document.querySelector('.nav.next'),
      calm=window.matchMedia('(prefers-reduced-motion:reduce)');
  function update(){
    var max=cards.scrollWidth-cards.clientWidth;
    prev.classList.toggle('show',cards.scrollLeft>4);
    next.classList.toggle('show',cards.scrollLeft<max-4);
  }
  function step(dir){
    var c=cards.querySelector('.card');
    var w=c.getBoundingClientRect().width+16;
    cards.scrollBy({left:dir*w,behavior:calm.matches?'auto':'smooth'});
  }
  prev.addEventListener('click',function(){step(-1)});
  next.addEventListener('click',function(){step(1)});
  var ticking=false;
  cards.addEventListener('scroll',function(){
    if(ticking)return;
    ticking=true;
    requestAnimationFrame(function(){ticking=false;update()});
  },{passive:true});
  window.addEventListener('resize',update);
  window.addEventListener('load',update);
  update();
})();
</script>
<script>
(function(){
  document.querySelectorAll('.glass').forEach(function(el){
    var x=0,y=0,queued=false;
    el.addEventListener('pointermove',function(e){
      if(e.pointerType==='touch')return;
      var r=el.getBoundingClientRect();
      x=e.clientX-r.left;y=e.clientY-r.top;
      if(queued)return;
      queued=true;
      requestAnimationFrame(function(){
        queued=false;
        el.style.setProperty('--mx',x+'px');
        el.style.setProperty('--my',y+'px');
        el.style.setProperty('--o','.9');
      });
    });
    el.addEventListener('pointerleave',function(){el.style.removeProperty('--o')});
  });
})();
</script>
<script>
(function(){
  var items=[].slice.call(document.querySelectorAll('.topnav li button')),
      ids=['top','contact','about','more'],
      locked=false,timer=0,ticking=false;
  function mark(id){
    items.forEach(function(a){
      if(a.getAttribute('data-target')===id)a.setAttribute('aria-current','location');
      else a.removeAttribute('aria-current');
    });
  }
  function pick(){
    var line=window.innerHeight*0.4,cur='top';
    ids.forEach(function(id){
      var el=document.getElementById(id);
      if(el&&el.getBoundingClientRect().top<=line)cur=id;
    });
    if(window.innerHeight+window.scrollY>=document.documentElement.scrollHeight-2)cur='more';
    mark(cur);
  }
  window.addEventListener('scroll',function(){
    if(locked||ticking)return;
    ticking=true;
    requestAnimationFrame(function(){ticking=false;pick()});
  },{passive:true});
  window.addEventListener('resize',pick);
  var calm=window.matchMedia('(prefers-reduced-motion:reduce)');
  [].slice.call(document.querySelectorAll('.topnav button')).forEach(function(a){
    a.addEventListener('click',function(){
      var id=a.getAttribute('data-target'),
          el=document.getElementById(id),
          y=(id==='top'||!el)?0:el.getBoundingClientRect().top+window.scrollY-68;
      window.scrollTo({top:Math.max(0,y),behavior:calm.matches?'auto':'smooth'});
      mark(id);
      locked=true;clearTimeout(timer);
      timer=setTimeout(function(){locked=false},900);
    });
  });
  pick();
})();
</script>
