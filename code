}
.icon svg{width:36px;height:36px;fill:currentColor}
.ig{background:linear-gradient(45deg,#feda75,#fa7e1e 28%,#d62976 55%,#962fbf 78%,#4f5bd5)}
.fb{background:linear-gradient(180deg,#2d93ff,#0866ff)}
.tt{background:linear-gradient(145deg,#2c2c30,#000)}
@media (hover:hover){
  .app:hover .icon{
    transform:translateY(-8px) scale(1.14);
    box-shadow:inset 0 1.5px 0 rgba(255,255,255,.7),0 26px 34px -12px rgba(0,0,0,.45);
  }
}
.app:focus-visible .icon{transform:translateY(-8px) scale(1.14);box-shadow:inset 0 1.5px 0 rgba(255,255,255,.7),0 26px 34px -12px rgba(0,0,0,.45);outline:3px solid var(--text);outline-offset:3px}
.app:active .icon{transform:scale(.94);transition-duration:.15s}
.app:focus-visible{outline:none}

.about{padding:28px}
