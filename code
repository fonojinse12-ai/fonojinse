  box-shadow:inset 0 1px 0 var(--edge);
}
.more{min-width:0}
.more h2{font-size:24px;font-weight:700;letter-spacing:-.02em;margin:10px 4px 14px}
.cards{display:flex;gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;padding:6px 2px 26px;margin:0 -2px;scrollbar-width:none}
.cards::-webkit-scrollbar{display:none}
.card{
  flex:0 0 min(100%,400px);min-height:440px;scroll-snap-align:start;
  display:flex;flex-direction:column;overflow:hidden;
  border-radius:28px;background:#000;color:#f5f5f7;text-decoration:none;
