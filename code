}
.card .copy{padding:30px 28px 0}
.card .label{font-size:14px;font-weight:600;color:#ff8a3d;margin-bottom:8px}
.card h3{font-size:34px;font-weight:700;letter-spacing:-.02em;line-height:1.1}
.card .desc{margin-top:14px;font-size:17px;font-weight:600;line-height:1.5}
.card .sub{margin-top:6px;font-size:17px;color:#c7c7cc}
.card .visual{
  position:relative;flex:1;min-height:200px;margin-top:12px;overflow:hidden;
  background:radial-gradient(120% 90% at 50% 115%,#5865f2 0%,#3b44b8 38%,rgba(0,0,0,0) 72%);
}
.card .visual svg{
  position:absolute;left:50%;bottom:-56px;width:270px;height:270px;fill:#fff;
  transform:translateX(-50%) rotate(-8deg);filter:drop-shadow(0 16px 26px rgba(20,20,80,.55));
  transition:transform .7s cubic-bezier(.16,1,.3,1);
}
@media (hover:hover){
