<style>
:root{
  --bg1:#f4f4f6; --bg2:#e2e2e6;
  --g1:#ffffff; --g2:#c6c6cc; --g3:#d9d9de;
  --glass:rgba(255,255,255,.34); --glass-strong:rgba(255,255,255,.5);
  --edge:rgba(255,255,255,.75); --edge-dim:rgba(255,255,255,.25);
  --text:#1d1d1f; --muted:#5b5b63; --shadow:rgba(0,0,0,.16);
  --nav:rgba(245,245,247,.72); --nav-line:rgba(0,0,0,.08);
}
@media (prefers-color-scheme:dark){
  :root{
    --bg1:#0a0a0b; --bg2:#151517;
    --g1:#3c3c41; --g2:#66666c; --g3:#2a2a2e;
    --glass:rgba(255,255,255,.09); --glass-strong:rgba(255,255,255,.15);
    --edge:rgba(255,255,255,.35); --edge-dim:rgba(255,255,255,.08);
    --text:#f5f5f7; --muted:#a1a1aa; --shadow:rgba(0,0,0,.5);
    --nav:rgba(22,22,24,.72); --nav-line:rgba(255,255,255,.1);
  }
}
*{box-sizing:border-box;margin:0}
html{height:100%;background:var(--bg1)}
body{
  min-height:100%;
  font-family:"Inter","Noto Sans Thai",sans-serif;
  font-synthesis:none;
  -webkit-text-size-adjust:100%;
  color:var(--text);
  background:transparent;
  padding:max(24px,env(safe-area-inset-top)) 20px max(32px,env(safe-area-inset-bottom));
  display:flex;justify-content:center;
  -webkit-font-smoothing:antialiased;
  overflow-x:hidden;
}
.bg{
  position:fixed;inset:0;z-index:0;pointer-events:none;
  background:
    radial-gradient(circle 60vmax at 12% 8%,var(--g1),transparent 100%),
    radial-gradient(circle 50vmax at 92% 45%,var(--g2),transparent 100%),
    radial-gradient(circle 45vmax at 30% 100%,var(--g3),transparent 100%),
    linear-gradient(160deg,var(--bg1),var(--bg2));
}

main{position:relative;z-index:1;width:100%;max-width:560px;display:grid;gap:18px;align-content:start;padding-top:calc(44px + 4vh)}
@media (prefers-reduced-motion:no-preference){html{scroll-behavior:smooth}}

.topnav{
  position:fixed;top:0;left:0;right:0;z-index:10;
  padding-top:env(safe-area-inset-top,0px);
  background:var(--nav);
  -webkit-backdrop-filter:blur(20px);backdrop-filter:blur(20px);
  border-bottom:1px solid var(--nav-line);
}
@supports not ((backdrop-filter:blur(1px)) or (-webkit-backdrop-filter:blur(1px))){
  .topnav{background:var(--bg1)}
}
.topnav .inner{
  max-width:980px;height:44px;margin:0 auto;padding:0 18px;
  display:flex;align-items:center;gap:14px;
}
.brand{
  flex:none;width:24px;height:24px;border-radius:50%;
  display:grid;place-items:center;overflow:hidden;
  background:linear-gradient(145deg,#6a9bff,#c86bff 60%,#ff8fb1);
  border:0;padding:0;cursor:pointer;font-family:inherit;
  -webkit-tap-highlight-color:transparent;
}
.brand img{display:block;width:100%;height:100%;border-radius:50%;object-fit:cover}
.topnav ul{
  list-style:none;padding:0;flex:1;min-width:0;
  display:flex;justify-content:space-evenly;gap:6px;
  overflow-x:auto;scrollbar-width:none;
}
.topnav ul::-webkit-scrollbar{display:none}
.topnav li button{
  background:none;border:0;cursor:pointer;font-family:inherit;text-align:center;
  display:block;padding:14px 6px;font-size:12px;line-height:16px;white-space:nowrap;
  color:var(--text);opacity:.6;text-decoration:none;
  transition:opacity .25s;-webkit-tap-highlight-color:transparent;
}
.topnav li button:hover,.topnav li button[aria-current="location"]{opacity:1}
.topnav button:focus-visible{outline:2px solid var(--text);outline-offset:-2px;border-radius:6px}

.glass{
  position:relative;
  background:var(--glass);
  -webkit-backdrop-filter:blur(28px);
  backdrop-filter:blur(28px);
  border:1px solid var(--edge-dim);
  border-radius:32px;
  box-shadow:
    inset 0 1.5px 0 var(--edge),
    inset 0 -1px 0 var(--edge-dim),
    inset 0 0 24px rgba(255,255,255,.08),
    0 18px 50px -12px var(--shadow);
  overflow:hidden;
}
/* light that follows the pointer, like light moving across curved glass */
.glass::before{
  content:"";position:absolute;inset:0;pointer-events:none;
  background:radial-gradient(360px circle at var(--mx,30%) var(--my,0%),rgba(255,255,255,.38),transparent 60%);
  opacity:var(--o,.55);transition:opacity .3s;
}
@supports not ((backdrop-filter:blur(1px)) or (-webkit-backdrop-filter:blur(1px))){
  .glass{background:var(--glass-strong)}
}

.hero{padding:44px 28px 34px;text-align:center}
.avatar{
  display:block;width:min(100%,280px);height:auto;margin:0 auto 22px;border-radius:24px;
  box-shadow:0 0 0 3px var(--edge),0 14px 34px -10px var(--shadow);
}
h1{font-size:clamp(34px,8vw,46px);font-weight:700;letter-spacing:-.03em;line-height:1.05}
.tag{margin-top:10px;font-size:19px;line-height:1.45;color:var(--text);opacity:.7}

.apps{display:flex;justify-content:center;gap:26px;padding:26px 20px 22px}
.app{display:grid;justify-items:center;gap:10px;text-decoration:none;color:var(--text);font-size:13px;-webkit-tap-highlight-color:transparent}
.icon{
  width:72px;height:72px;border-radius:22px;display:grid;place-items:center;color:#fff;
  box-shadow:inset 0 1.5px 0 rgba(255,255,255,.55),0 8px 18px -8px rgba(0,0,0,.35);
