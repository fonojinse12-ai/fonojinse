  .card:hover .visual svg{transform:translateX(-50%) rotate(-4deg) scale(1.06)}
}
.rail{position:relative}
.nav{
  position:absolute;top:calc(50% - 13px);z-index:3;
  width:52px;height:52px;margin-top:-26px;padding:0;border:0;border-radius:50%;
  display:grid;place-items:center;cursor:pointer;color:#1d1d1f;
